# =============================================================================
# HexStrike server — arm64-NATIVE + เครื่องมือครบชุด (สำหรับ Apple Silicon / Mac)
# -----------------------------------------------------------------------------
# ต่างจาก Dockerfile.hexstrike-server (Kali/amd64) ตรงที่ตัวนี้เป็น debian arm64
# แท้ → รัน NATIVE บน M-series ไม่ emulate และลงเครื่องมือให้ "ครบ" ที่สุดเท่าที่
# ทำได้บน arm64:
#   - apt:   nmap masscan dirb wfuzz sqlmap hydra john dnsenum dnsrecon whois
#            jq openssl dnsutils(dig) netcat ฯลฯ
#   - Go:    nuclei httpx subfinder naabu katana dnsx gobuster ffuf dalfox gau
#            waybackurls hakrawler anew qsreplace amass
#   - Rust:  feroxbuster (binary สำเร็จรูป)
#   - clone: whatweb (ruby) + nikto (perl)
#   - pip:   wafw00f + theHarvester (OSINT)
#   - data:  nuclei templates + SecLists wordlists
#
# ออกแบบให้ "ทนพลาด": ตัวที่โหลด/บิลด์ไม่สำเร็จจะข้าม (|| echo skip) ไม่ล้มทั้ง
# build — hexstrike จะรายงาน tool ที่ขาดว่า unavailable เฉยๆ
#
# ⚠️ build นานขึ้นมาก (Go compile หลายตัว) และ image ใหญ่ขึ้น (SecLists ~1GB+)
#    ไม่อยากได้ SecLists:  --build-arg INSTALL_SECLISTS=false
# =============================================================================
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    HEXSTRIKE_PORT=8888

ARG INSTALL_SECLISTS=true
ARG GO_VERSION=1.23.4

# ── ชั้น 1: build toolchain + ภาษา/ไลบรารีที่เครื่องมือต้องใช้ (ต้องมีจริง) ────
#   ruby/perl+libnet-ssleay → whatweb/nikto ; libpcap-dev → naabu ; cargo → rust
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv python3-dev \
      build-essential libffi-dev libssl-dev pkg-config cargo rustc \
      curl wget git ca-certificates unzip libpcap-dev \
      ruby perl libnet-ssleay-perl \
    && rm -rf /var/lib/apt/lists/*

# ── ชั้น 2: security tools จาก apt — ลงทีละตัว ตัวที่ debian ไม่มี ข้ามไป ──────
RUN apt-get update && for t in \
      nmap masscan dnsutils dnsenum dnsrecon whois \
      jq openssl \
      dirb wfuzz sqlmap hydra john netcat-traditional \
      chromium chromium-driver ; do \
      apt-get install -y --no-install-recommends "$t" \
        && echo "  [apt] ✓ $t" \
        || echo "  [apt] ⚠ ข้าม $t" ; \
    done ; rm -rf /var/lib/apt/lists/*

# ── ชั้น 3: Go toolchain (official arm64) — debian golang เก่าไปสำหรับ PD tools ──
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-arm64.tar.gz" -o /tmp/go.tgz \
    && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz \
    && /usr/local/go/bin/go version
ENV PATH="/usr/local/go/bin:/usr/local/bin:${PATH}" \
    GOBIN=/usr/local/bin \
    GOFLAGS=-buildvcs=false

# ── ชั้น 4: Go-based tools (ProjectDiscovery + gobuster) — ทนพลาดทีละตัว ──────
#   PD httpx ตัวนี้รองรับ -l (แก้ปัญหา "No such option '-l'" ของ httpx ตัวเดิม)
RUN set -x; \
    go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest       || echo "⚠ skip nuclei"; \
    go install github.com/projectdiscovery/httpx/cmd/httpx@latest            || echo "⚠ skip httpx"; \
    go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest || echo "⚠ skip subfinder"; \
    go install github.com/projectdiscovery/naabu/v2/cmd/naabu@latest         || echo "⚠ skip naabu"; \
    go install github.com/projectdiscovery/katana/cmd/katana@latest          || echo "⚠ skip katana"; \
    go install github.com/projectdiscovery/dnsx/cmd/dnsx@latest              || echo "⚠ skip dnsx"; \
    go install github.com/OJ/gobuster/v3@latest                              || echo "⚠ skip gobuster"; \
    go install github.com/ffuf/ffuf/v2@latest                                || echo "⚠ skip ffuf"; \
    go install github.com/hahwul/dalfox/v2@latest                            || echo "⚠ skip dalfox"; \
    go install github.com/lc/gau/v2/cmd/gau@latest                           || echo "⚠ skip gau"; \
    go install github.com/tomnomnom/waybackurls@latest                       || echo "⚠ skip waybackurls"; \
    go install github.com/hakluke/hakrawler@latest                           || echo "⚠ skip hakrawler"; \
    go install github.com/tomnomnom/anew@latest                              || echo "⚠ skip anew"; \
    go install github.com/tomnomnom/qsreplace@latest                         || echo "⚠ skip qsreplace"; \
    go install github.com/owasp-amass/amass/v4/...@master                    || echo "⚠ skip amass"; \
    go clean -cache -modcache 2>/dev/null || true

# ── ชั้น 5: feroxbuster (ตัวติดตั้งทางการ auto-detect arch → binary arm64) ────
RUN curl -fsSL https://raw.githubusercontent.com/epi052/feroxbuster/main/install-nix.sh \
      | bash -s /usr/local/bin \
    && /usr/local/bin/feroxbuster --version || echo "⚠ skip feroxbuster"

# ── ชั้น 6: whatweb (ruby) + nikto (perl) จาก git ───────────────────────────
RUN git clone --depth 1 https://github.com/urbanadventurer/WhatWeb /opt/whatweb \
      && ln -sf /opt/whatweb/whatweb /usr/local/bin/whatweb \
      && echo "✓ whatweb" || echo "⚠ skip whatweb"
RUN git clone --depth 1 https://github.com/sullo/nikto /opt/nikto \
      && ln -sf /opt/nikto/program/nikto.pl /usr/local/bin/nikto \
      && echo "✓ nikto" || echo "⚠ skip nikto"

# ── ชั้น 7: data — nuclei templates + SecLists wordlists ────────────────────
RUN (command -v nuclei >/dev/null && nuclei -update-templates -silent) \
      && echo "✓ nuclei templates" \
      || echo "⚠ nuclei templates จะโหลดตอนรันครั้งแรกแทน"
RUN if [ "$INSTALL_SECLISTS" = "true" ]; then \
      git clone --depth 1 https://github.com/danielmiessler/SecLists /usr/share/seclists \
        && echo "✓ SecLists -> /usr/share/seclists" \
        || echo "⚠ skip SecLists (clone พลาด)"; \
    else echo "skip SecLists (INSTALL_SECLISTS=$INSTALL_SECLISTS)"; fi

# ── ชั้น 8: python deps ของ hexstrike_server.py (venv แยก ไม่แตะ system python) ─
WORKDIR /app
COPY hexstrike-ai-main/requirements.txt /app/requirements.txt
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
# ตัด angr/pwntools (อยู่ใน f-string ที่ server เขียนเป็นไฟล์ให้ผู้ใช้ ไม่ใช่ import
# จริง — ตัดได้ไม่กระทบ endpoint, เป็น dep tree หนัก/เปราะสุดโดยเฉพาะบน arm64)
RUN grep -viE '^(angr|pwntools)([><=~ ]|$)' /app/requirements.txt > /app/requirements.container.txt \
    && pip install --no-cache-dir -r /app/requirements.container.txt
# เครื่องมือ OSINT/recon แบบ python (ทนพลาด — ตัวไหนลงไม่ได้ข้าม ไม่ล้ม build)
RUN pip install --no-cache-dir wafw00f    || echo "⚠ skip wafw00f"
RUN pip install --no-cache-dir theHarvester || echo "⚠ skip theHarvester"

# โค้ด server ถูก mount เข้ามาตอน runtime (ดู docker-compose.mac.yml) จึงไม่ COPY
ENV CHROME_BIN=/usr/bin/chromium \
    CHROMEDRIVER_PATH=/usr/bin/chromedriver \
    SECLISTS_PATH=/usr/share/seclists

EXPOSE 8888
CMD ["python3", "/app/hexstrike-ai-main/hexstrike_server.py", "--port", "8888"]
