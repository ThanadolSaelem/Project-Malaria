# คัดลอกเป็น llama.env แล้วแก้ให้ตรงเครื่อง:  cp llama.env.example llama.env
# start.command จะอ่านไฟล์นี้เพื่อสตาร์ท llama.cpp ให้อัตโนมัติ (ถ้าพอร์ตยังว่าง)
#
# มี 2 โมเดลรันคู่กัน (RAM ~45GB รวม — เครื่องคุณเหลือ ~72GB สบาย):
#   1) ORCHESTRATOR (:8090) = Cyber-Tiel-Coder-35B-A3B  → วางแผน + เรียก tool
#   2) SPECIALIST  (:8091) = BugTraceAI-CORE-Ultra-27B  → เขียน exploit/PoC/payload
#      (Tiel เรียกผ่าน MCP tool `ask_exploit_specialist`)
#
# กติกาสำคัญของ LLAMA_CMD ทั้งคู่:
#   - --port ต้องตรงกับที่ litellm-config.yaml ชี้ (8090 และ 8091)
#   - --alias ต้องตรงกับ `model: openai/<alias>` ใน litellm-config.yaml
#       :8090 → --alias cybermodel
#       :8091 → --alias exploit-specialist
#   - -ngl 99 โหลดทุก layer ลง Metal (GPU) ของ Apple Silicon
#   - --jinja เปิด tool calling — จำเป็นเฉพาะ ORCHESTRATOR (ตัวที่เรียก HexStrike)
#     SPECIALIST ไม่เรียก tool (text-in/out ล้วน) จะใส่หรือไม่ใส่ก็ได้
#   - อย่าใส่ --api-key สำหรับ loopback ภายในเครื่อง (litellm ใช้ "sk-local" เป็น
#     placeholder อยู่แล้ว ถ้าใส่ key จริงต้องให้ตรงกันสองฝั่ง)

# ── 1) ORCHESTRATOR — Cyber-Tiel-Coder-35B-A3B บน :8090 ──────────────────────
export LLAMA_PORT=8090
export LLAMA_CMD='llama-server \
  -m /path/to/Cyber-Tiel-Coder-35B-A3B.gguf \
  --host 0.0.0.0 --port 8090 \
  --alias cybermodel \
  -ngl 99 --jinja \
  -c 16384'

# ── 2) SPECIALIST — BugTraceAI-CORE-Ultra-27B บน :8091 ───────────────────────
# ปล่อยว่าง (คอมเมนต์ไว้) ได้ ถ้ายังไม่อยากรันตัวที่ 2 — pipeline ส่วนอื่นยังทำงานปกติ
# แค่ tool `ask_exploit_specialist` จะคืน error จนกว่าจะสตาร์ทตัวนี้
#   Q6_K ~21GB (คมสุดเท่าที่ RAM ไหว) / Q4_K_S ~15GB (ประหยัดกว่า)
# สลับไป DeepHat-V1-7B ก็แค่เปลี่ยน SPECIALIST_MODEL_FILE เป็นไฟล์ gguf ของ DeepHat
# (+ อัปเดต SPECIALIST_MODEL_SHA256 ให้ตรงไฟล์ใหม่) — alias/tool คงเดิม
export LLAMA_PORT_SPECIALIST=8091

# path ของไฟล์ gguf (ใช้เป็นแหล่งเดียว ทั้งใน -m และสำหรับเช็ก SHA256)
export SPECIALIST_MODEL_FILE='/path/to/BugTraceAI-CORE-Ultra-27B.Q6_K.gguf'

# ── ความปลอดภัย (hardening ของ specialist) ───────────────────────────────────
# (3) SHA256 ที่คาดหวัง — เอามาจากหน้า repo ทางการ (ดู SHA256SUMS/model card)
#     start.command จะเช็กก่อนสตาร์ท ถ้าไม่ตรง = ไม่สตาร์ท (กันไฟล์ถูกแก้/re-upload ปลอม)
#     ว่าง = ข้ามการเช็ก (ไม่แนะนำ)   | หา hash เอง:  shasum -a 256 <file.gguf>
export SPECIALIST_MODEL_SHA256=''

# (1a) chat template ที่เชื่อถือได้ — override template ที่ฝังมาในไฟล์ gguf
#      (จุดที่ "Poisoned GGUF Templates" ฝังคำสั่งอันตราย). ดีฟอลต์ = chatml.jinja ข้างไฟล์นี้
#      ถ้า build llama.cpp ไม่รองรับ --chat-template-file ให้ใช้ --chat-template chatml แทน
export SPECIALIST_CHAT_TEMPLATE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/chatml.jinja"

# (1b) sandbox กันออกเน็ต — 1 = เปิด (ดีฟอลต์), 0 = ปิด (ถ้า llama ไม่ยอมขึ้นใต้ sandbox)
export SPECIALIST_SANDBOX=1
export SPECIALIST_SANDBOX_PROFILE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/specialist-sandbox.sb"

# --jinja ไม่จำเป็น (specialist ไม่เรียก tool) — ไม่ใส่เพื่อลด surface ของ template engine
export LLAMA_CMD_SPECIALIST='llama-server \
  -m "$SPECIALIST_MODEL_FILE" \
  --host 0.0.0.0 --port 8091 \
  --alias exploit-specialist \
  --chat-template-file "$SPECIALIST_CHAT_TEMPLATE" \
  -ngl 99 \
  -c 16384'

# ── 3) SUMMARIZER — โมเดลเล็กสำหรับ observer dashboard (:8092) ────────────────
# ดีฟอลต์ Qwen2.5-3B-Instruct (~2-3GB Q4) สรุปงานของ Tiel เป็น EN+TH แบบ parallel
# ปล่อยว่าง (คอมเมนต์) ได้ถ้ายังไม่ใช้ dashboard — ส่วนอื่นทำงานปกติ
# ไม่ต้อง sandbox (เป็นโมเดล mainstream ไม่ใช่ offensive) / --alias ต้อง = summarizer
export LLAMA_PORT_SUMMARIZER=8092
export SUMMARIZER_MODEL_FILE='/path/to/Qwen2.5-3B-Instruct-Q4_K_M.gguf'
export SUMMARIZER_MODEL_SHA256=''   # ตั้งได้ถ้าอยากให้เช็ก (ว่าง = ข้าม)
export LLAMA_CMD_SUMMARIZER='llama-server \
  -m "$SUMMARIZER_MODEL_FILE" \
  --host 0.0.0.0 --port 8092 \
  --alias summarizer \
  --jinja \
  -ngl 99 \
  -c 8192'
