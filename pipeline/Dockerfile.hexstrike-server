# =============================================================================
# HexStrike server — ตัวที่รันเครื่องมือจริง (Kali base)
# -----------------------------------------------------------------------------
# หมายเหตุตรงๆ: image นี้หนัก (หลาย GB) และผม build/ทดสอบที่นี่ไม่ได้ (ไม่มี
# docker daemon) apt package บางชื่ออาจเพี้ยน/ไม่มีใน repo ช่วงที่คุณ build
# ถ้าตัวไหนพัง ให้ตัดออกจากบรรทัด apt แล้ว build ต่อ — server จะยังรันได้และ
# แค่รายงานว่า tool นั้น "unavailable" (health check รองรับกรณีนี้อยู่แล้ว)
#
# ลงชุด "core" ตามที่ README ของ hexstrike แนะนำเป็นหลัก เครื่องมือที่เหลือ
# (rustscan, httpx, katana, ฯลฯ ที่เป็น Go/แยก installer) เพิ่มเองภายหลังได้
#
# เพิ่มจากที่โมเดลฟ้องว่าขาด: wafw00f, fierce (อยู่ใน repo Kali) + wordlists
# (เติม /usr/share/wordlists/ ที่เคยว่าง) + ดึง nuclei templates ตอน build
# ถ้า wafw00f/fierce หาไม่เจอในช่วงที่ build ให้ตัดออกแล้ว build ต่อได้ตามเดิม
#
# ทำไมมี build toolchain (gcc/rust) ข้างล่าง: kali-rolling เป็น image ที่
# ตาม Python เวอร์ชันล่าสุดของ Debian testing ตลอดเวลา (ตอนนี้คือ 3.14) ซึ่งใหม่
# กว่าที่ package หลายตัวบน PyPI มี prebuilt wheel ให้ (โดยเฉพาะสายที่ mitmproxy
# ดึงมา เช่น zstandard, cryptography) พอไม่มี wheel ตรง pip จะ compile จาก
# source เอง ถ้าไม่มี compiler ใน image การ build จะพังแบบที่เจอ (cffi/zstandard
# หา gcc ไม่เจอ) เพิ่ม build-essential + libffi/libssl headers + rust ไว้กัน
# =============================================================================
FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    HEXSTRIKE_PORT=8888

# Pin mirror ตรงไปที่ kali.download (Cloudflare CDN) แทน redirector http.kali.org
# ที่สุ่มเด้งไป mirror ช้า/ล่ม (เคส build นี้เด้งไป mirror.kku.ac.th แล้วค้าง 30+ นาที
# วน Ign ไม่คืบ) การ pin CDN ตรงๆ ทำให้ build reproducible ไม่ขึ้นกับ mirror สุ่ม
# + ForceIPv4 กัน IPv6 resolve เพี้ยน + Retries 5 (เดิม 15 ทำให้ค้างนานเกินตอน mirror พัง)
RUN echo 'deb http://kali.download/kali kali-rolling main contrib non-free non-free-firmware' \
        > /etc/apt/sources.list \
    && echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 \
    && echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/99retries \
    && echo 'Acquire::http::Pipeline-Depth "0";' > /etc/apt/apt.conf.d/99no-pipeline

# ── core security tools + build toolchain (สำหรับ pip package ที่ไม่มี wheel
#    สำหรับ Python เวอร์ชันที่ kali-rolling ให้มา — ดูเหตุผลด้านบน) ──────────
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv python3-dev \
      build-essential libffi-dev libssl-dev pkg-config rustc cargo \
      curl wget git ca-certificates unzip \
      nmap masscan dnsenum dnsrecon fierce \
      nikto whatweb gobuster ffuf feroxbuster dirb wfuzz wafw00f \
      sqlmap nuclei subfinder amass \

# nuclei จาก apt มาแบบไม่มี template — ต้องดึงเองครั้งแรก ไม่งั้นสั่ง nuclei แล้ว
# ไม่มีอะไรให้สแกน ดึงตอน build ฝังลง image เลย (|| true กัน build ล้มถ้าเน็ตสะดุด
# ตอนนั้น รันซ้ำตอน runtime ได้ด้วย `nuclei -update-templates`)
RUN nuclei -update-templates || true

# ── python deps ของ hexstrike_server.py ────────────────────────────────────
WORKDIR /app
COPY hexstrike-ai-main/requirements.txt /app/requirements.txt

# ติดตั้งลง venv แยก ไม่ใช่ system python ของ Kali โดยตรง เพราะ Kali ลง Python
# package หลายตัวผ่าน apt (dpkg) ไม่ใช่ pip — พวกนี้ไม่มี RECORD file พอ pip
# ต้อง "อัปเกรด/แทนที่" ตัวใดตัวหนึ่ง (เช่น mitmproxy อยาก pyparsing<=3.1.2 แต่
# Debian ลง 3.3.2 ไว้) pip จะ uninstall ของเดิมไม่ได้ -> error: uninstall-no
# -record-file แล้ว build ล้ม. venv โดยดีฟอลต์ไม่ดึง system site-packages จึง
# ติดตั้งทุกอย่างสดใหม่ ไม่ไปแตะ/ชนกับ package ที่ apt ลงไว้เลย
# (deps ของ hexstrike_server.py อยู่ใน requirements.txt ครบ ไม่ต้องพึ่งของ apt)
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# ตัด angr และ pwntools ออก: เช็คซอร์ส hexstrike_server.py แล้วทั้งคู่ไม่ได้ถูก
# import จริงตอนรัน — `from pwn import *` (บรรทัด ~12320) กับ `import angr`
# (บรรทัด ~12523) อยู่ใน f-string ที่ server "เขียนออกเป็นไฟล์สคริปต์" ให้ผู้ใช้
# เอาไปรันเองต่างหาก ไม่ใช่โค้ดที่ process นี้ต้อง import เอง (requirements.txt
# เองก็กำกับว่า "CONDITIONALLY USED") ตัดทิ้งได้จริง ไม่กระทบ endpoint ไหนเลย
# และเป็น dependency tree ที่หนัก/เปราะที่สุดในไฟล์ (native build เพียบ)
# ถ้าอยากได้ไว้ใช้จริงในนี้ด้วย ลบสองบรรทัด grep -v นี้ออก แล้วเผื่อเวลา build
# นานขึ้นมาก (และอาจต้องเพิ่ม cmake/z3 headers เอง)
RUN grep -viE '^(angr|pwntools)([><=~ ]|$)' /app/requirements.txt > /app/requirements.container.txt \
    && pip install --no-cache-dir -r /app/requirements.container.txt

# แก้ httpx "-l"/"-list" ใช้ไม่ได้: Kali ไม่มี ProjectDiscovery httpx ใน repo
# (package "httpx-toolkit" เป็น metapackage ที่ดึง python3-httpx ซึ่ง CLI ชื่อ httpx
# เหมือนกันแต่ไม่รองรับ -l) → ดาวน์โหลด PD httpx binary จาก GitHub release ตรงๆ ตาม
# arch แล้วชี้ `httpx` ตัวแรกบน PATH (/opt/venv/bin มาก่อน) ไปที่มัน
# resolve เวอร์ชันล่าสุดตอน build (API ล่ม → fallback เวอร์ชัน pin); ทนพลาด (|| WARN)
# ไม่กระทบ `import httpx` ของ python (เป็น library ใน site-packages คนละตัวกับ binary)
RUN A="$(dpkg --print-architecture)"; \
    VER="$(curl -fsSL https://api.github.com/repos/projectdiscovery/httpx/releases/latest \
            | grep -oE '"tag_name"[ :]+"v[0-9.]+"' | grep -oE '[0-9]+(\.[0-9]+)+' | head -1)"; \
    VER="${VER:-1.6.10}"; \
    url="https://github.com/projectdiscovery/httpx/releases/download/v${VER}/httpx_${VER}_linux_${A}.zip"; \
    if curl -fsSL "$url" -o /tmp/httpx.zip && unzip -o /tmp/httpx.zip httpx -d /usr/local/bin; then \
      chmod +x /usr/local/bin/httpx \
      && ln -sf /usr/local/bin/httpx /opt/venv/bin/httpx \
      && rm -f /tmp/httpx.zip \
      && echo "PD httpx v${VER} (${A}) -> /opt/venv/bin/httpx"; \
    else echo "WARN: ติดตั้ง PD httpx ไม่สำเร็จ (url=$url) — httpx -l อาจยังพัง"; fi

# โค้ด server ถูก mount เข้ามาตอน runtime (ดู docker-compose) จึงไม่ COPY ทั้งชุด
# ให้ selenium หา chromium ที่ apt ลงไว้เจอ
ENV CHROME_BIN=/usr/bin/chromium \
    CHROMEDRIVER_PATH=/usr/bin/chromedriver

EXPOSE 8888
CMD ["python3", "/app/hexstrike-ai-main/hexstrike_server.py", "--port", "8888"]
