# mac os files
.DS_Store
*.DS_Store
*/.DS_Store

# pipeline secrets
pipeline/.env

# python cache
__pycache__/
*.pyc

# mac native hexstrike venv
pipeline/mac/hexstrike-env/
pipeline/mac/.reqs.txt

# mac one-button local config + logs
pipeline/mac/llama.env
pipeline/mac/logs/

# handshake/hash ที่จับมา — ไม่ commit (sensitive + ใหญ่) เก็บแค่ README
pipeline/captures/*
!pipeline/captures/README.txt

# ไฟล์เป้าหมายที่จะแกะด้วย REA — ไม่ commit (อาจเป็น malware/ใหญ่) เก็บแค่ README
pipeline/rea-targets/*
!pipeline/rea-targets/README.txt

# รูปหลักฐานของเคส — ไม่ commit (sensitive) เก็บแค่ README
pipeline/evidence/*
!pipeline/evidence/README.txt

# รายงานที่ประกอบแล้ว (.json/.docx ของเคส) — ไม่ commit เก็บแค่ README
pipeline/reports/*
!pipeline/reports/README.txt

# finetune dataset (sensitive TLP:AMBER gold reports and extracted json — local only)
pipeline/reporting/finetune/gold_13/
pipeline/reporting/finetune/gold_json/

# home/workspace ของ deepseek-harness agent (ไฟล์งานเคส/อาจ sensitive) — ไม่ commit เก็บแค่ README
pipeline/dsh-workspace/*
!pipeline/dsh-workspace/README.txt

# dynamic host LAN IP state shared with qwen-code container
pipeline/qwen-code/runtime/

# artex runtime data, keys, dist, and local config
pipeline/artex/.env
pipeline/artex/config.json
pipeline/artex/data/*
!pipeline/artex/data/.gitkeep
pipeline/artex/keys/*
!pipeline/artex/keys/.gitkeep
pipeline/artex/dist/
pipeline/artex/server/webui/dist/

# scopesentry runtime data and local config
pipeline/scopesentry/.env
pipeline/scopesentry/data/


