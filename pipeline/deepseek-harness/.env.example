# คัดลอกเป็น .env (หรือ export เอง) ก่อนรัน deploy.sh
# คีย์สำหรับ provider ของ deepseek-harness ชี้ LiteLLM (llama ไม่เช็ค ใส่ placeholder ได้)
export LITELLM_KEY=sk-local

# ที่เก็บ config/profile ของ deepseek-harness (ดีฟอลต์ ~/.dsh)
export DSH_HOME="$HOME/.dsh"

# (ออปชัน) ถ้าจะใช้โมเดล nim (Nemotron VL cloud) — งาน non-sensitive เท่านั้น
# ปกติอ่านจาก pipeline/.env อยู่แล้ว ใส่ซ้ำที่นี่ก็ได้
# export NVIDIA_API_KEY=nvapi-...
