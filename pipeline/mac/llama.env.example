# คัดลอกเป็น llama.env แล้วแก้ให้ตรงเครื่อง:  cp llama.env.example llama.env
# start.command / run-models.command จะอ่านไฟล์นี้เพื่อสตาร์ท llama.cpp ให้อัตโนมัติ
# =============================================================================
# โครงสร้างการปรับจูนลดความร้อน (Thermal & Memory Bandwidth Optimization)
#   สำหรับเครื่อง Mac Apple Silicon (เช่น 12 Performance Cores, RAM 128GB)
# -----------------------------------------------------------------------------
# 1) Flash Attention (-fa on)        : ลดภาระการอ่าน/เขียนหน่วยความจำของ Attention
# 2) KV Cache Quantization           : -ctk q8_0 -ctv q8_0 (หรือเปลี่ยนเป็น q4_0 ได้)
#                                      ช่วยลดข้อมูลที่วิ่งผ่าน Memory Bus ลง 50%–75%
# 3) จำกัด CPU Threads (-t / -tb)    : ตั้งไว้ที่ 50%–70% ของ P-Cores (เช่น -t 6 -tb 8)
#                                      ป้องกัน CPU ถูกอัดไฟ 100% ทุกคอร์ตอนสลับ Expert/Dequantize
# 4) ควบคุม Context & Batch (-c/-b)  : จำกัด -c เหลือ 16384 (หรือ 8192), ล็อก -np 1 (1 slot)
#                                      และคุม -b 512 -ub 256 กันขนาดรวมล้น RAM จนเกิด SSD Swap
# 5) แผนการเลือก Quantization & โมเดล :
#    • หลีกเลี่ยง IQ1_M / IQ2 บนโมเดล MoE ขนาดใหญ่ (เช่น DeepSeek-V4.1-Flash 552B เต็ม)
#      เพราะใช้พลังประมวลผลในการ Dequantize สูงมากและเสี่ยงเกิด SSD Swap Thrashing
#    • เน้นฟอร์แมตที่ถอดรหัสไวกว่า (MXFP4 หรือ Q4_K_M) ในขนาดที่ไม่เกิน RAM
#    • หากต้องการทดสอบ DeepSeek-V4.1-Flash-1017 Uncensored ให้ตั้ง ORCHESTRATOR_PROFILE
#      เป็น "deepseek-v4.1-coder" ซึ่งใช้รุ่นตัด Pruning สำหรับงานโค้ด (~72GB):
#      Abiray/DeepSeek-V4.1-Flash-1017-Uncensored-GSQ-RCO-Coder-GGUF
# =============================================================================

# ── พารามิเตอร์ควบคุมความร้อนส่วนกลาง ──────────────────────────────────────────
export LLAMA_THREADS="${LLAMA_THREADS:-6}"              # 50%–70% ของ Performance Cores (เช่น 6 จาก 12 P-Cores)
export LLAMA_THREADS_BATCH="${LLAMA_THREADS_BATCH:-8}"  # เธรดตอน prefill prompt
export LLAMA_THREADS_HELPER="${LLAMA_THREADS_HELPER:-4}" # เธรดสำหรับโมเดลเสริม (:8092, :8093)

export LLAMA_KV_TYPE="${LLAMA_KV_TYPE:-q8_0}"           # q8_0 หรือ q4_0
export LLAMA_CTX_MAIN="${LLAMA_CTX_MAIN:-65536}"        # 65536 (64k Context รองรับแชทยาวต่อเนื่องและ System+MCP Tools สบายๆ)
export LLAMA_CTX_HELPER="${LLAMA_CTX_HELPER:-8192}"     # 8192
export LLAMA_BATCH="${LLAMA_BATCH:-512}"                # -b 512
export LLAMA_UBATCH="${LLAMA_UBATCH:-256}"              # -ub 256

# ── 1) ORCHESTRATOR (:8090) — เลือกโปรไฟล์โมเดลหลัก ───────────────────────────
# ตัวเลือก ORCHESTRATOR_PROFILE:
#   • "qwen2.5-coder-32b"   = (แนะนำสูงสุด) Qwen2.5-Coder-32B-Instruct (~19.8GB, แชมป์ Code, ไวกว่า 120B หลายเท่า)
#   • "qwen2.5-coder-14b"   = Qwen2.5-Coder-14B-Instruct (~9GB, ไวติดจรวด ตอบใน 1 วินาที)
#   • "flint"               = (แนะนำความเร็วสูงสุด) Recursive Flint 40B-A2.5B (~25.1GB, MoE Active 2.5B ไวกว่า Dense หลายเท่า)
#   • "qwen2.5-coder-32b"   = Qwen2.5-Coder-32B-Instruct (~19.8GB, Dense)
#   • "qwen2.5-coder-14b"   = Qwen2.5-Coder-14B-Instruct (~9GB, ไวติดจรวด ตอบใน 1 วินาที)
#   • "gpt-oss-120b"        = gpt-oss-120b MXFP4 (~63GB, MoE 117B/5.1B active)
#   • "deepseek-v4.1-coder" = รุ่นตัด Pruning งานโค้ด (~72GB, แทนรุ่นเต็ม 552B IQ1_M)
#   • "cyber-tiel-35b"      = โหมดประหยัดพลังงานสูงสุด (MoE 35B/3B active)
export LLAMA_PORT=8090
export ORCHESTRATOR_PROFILE="${ORCHESTRATOR_PROFILE:-flint}"

export FLINT_MODEL_FILE="${FLINT_MODEL_FILE:-$HOME/models/flint-UD-Q4_K_XL.gguf}"
export QWEN_CODER_32B_MODEL_FILE="${QWEN_CODER_32B_MODEL_FILE:-$HOME/models/qwen2.5-coder-32b-instruct-q4_k_m.gguf}"
export QWEN_CODER_14B_MODEL_FILE="${QWEN_CODER_14B_MODEL_FILE:-$HOME/models/qwen2.5-coder-14b-instruct-q4_k_m.gguf}"
export GPT_OSS_120B_MODEL_FILE="${GPT_OSS_120B_MODEL_FILE:-$HOME/models/gpt-oss-120b-bliterated/model-mxfp4.gguf}"
export DEEPSEEK_V41_CODER_MODEL_FILE="${DEEPSEEK_V41_CODER_MODEL_FILE:-$HOME/models/Abiray/DeepSeek-V4.1-Flash-1017-Uncensored-GSQ-RCO-Coder-GGUF/DeepSeek-V4.1-Flash-1017-Uncensored-GSQ-RCO-Coder-Q4_K_M.gguf}"
export CYBER_TIEL_ORCH_MODEL_FILE="${CYBER_TIEL_ORCH_MODEL_FILE:-/path/to/Cyber-Tiel-Coder-35B-A3B-Q4_K_M.gguf}"

case "$ORCHESTRATOR_PROFILE" in
  flint)
    export ORCHESTRATOR_MODEL_FILE="$FLINT_MODEL_FILE"
    ;;
  qwen2.5-coder-32b)
    export ORCHESTRATOR_MODEL_FILE="$QWEN_CODER_32B_MODEL_FILE"
    ;;
  qwen2.5-coder-14b)
    export ORCHESTRATOR_MODEL_FILE="$QWEN_CODER_14B_MODEL_FILE"
    ;;
  deepseek-v4.1-coder)
    export ORCHESTRATOR_MODEL_FILE="$DEEPSEEK_V41_CODER_MODEL_FILE"
    ;;
  cyber-tiel-35b)
    export ORCHESTRATOR_MODEL_FILE="$CYBER_TIEL_ORCH_MODEL_FILE"
    ;;
  *)
    export ORCHESTRATOR_MODEL_FILE="$GPT_OSS_120B_MODEL_FILE"
    ;;
esac

export LLAMA_CMD='llama-server \
  -m "$ORCHESTRATOR_MODEL_FILE" \
  --host 0.0.0.0 --port 8090 \
  --alias cybermodel \
  -ngl 99 \
  -fa on \
  -ctk "$LLAMA_KV_TYPE" -ctv "$LLAMA_KV_TYPE" \
  -t "$LLAMA_THREADS" -tb "$LLAMA_THREADS_BATCH" \
  -c "$LLAMA_CTX_MAIN" -np 1 \
  -b "$LLAMA_BATCH" -ub "$LLAMA_UBATCH" \
  --n-predict -1 \
  --jinja'

# ── 2) SPECIALIST (:8091) — Cyber-Model / BugTraceAI ──────────────────────
# แนะนำ Q4_K_M (~20GB) หรือ MXFP4 เพื่อลดภาระ Memory Bandwidth เมื่อรันคู่กับโมเดลใหญ่บน :8090
export LLAMA_PORT_SPECIALIST=8091
export SPECIALIST_MODEL_FILE='/path/to/Cyber-Tiel-Coder-35B-A3B-Q4_K_M.gguf'
export SPECIALIST_MODEL_SHA256=''
export SPECIALIST_CHAT_TEMPLATE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/chatml.jinja"
export SPECIALIST_SANDBOX=1
export SPECIALIST_SANDBOX_PROFILE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/specialist-sandbox.sb"

export LLAMA_CMD_SPECIALIST='llama-server \
  -m "$SPECIALIST_MODEL_FILE" \
  --host 0.0.0.0 --port 8091 \
  --alias exploit-specialist \
  -ngl 99 \
  -fa on \
  -ctk "$LLAMA_KV_TYPE" -ctv "$LLAMA_KV_TYPE" \
  -t "$LLAMA_THREADS" -tb "$LLAMA_THREADS_BATCH" \
  -c "$LLAMA_CTX_MAIN" -np 1 \
  -b "$LLAMA_BATCH" -ub "$LLAMA_UBATCH" \
  --n-predict -1 \
  --jinja'

# ── 3) SUMMARIZER (:8092) — โมเดลเล็กสำหรับ Intent Classifier & Observer ───────
export LLAMA_PORT_SUMMARIZER=8092
export SUMMARIZER_MODEL_FILE='/path/to/Qwen2.5-3B-Instruct-Q4_K_M.gguf'
export SUMMARIZER_MODEL_SHA256=''
export LLAMA_CMD_SUMMARIZER='llama-server \
  -m "$SUMMARIZER_MODEL_FILE" \
  --host 0.0.0.0 --port 8092 \
  --alias summarizer \
  -ngl 99 \
  -fa on \
  -ctk "$LLAMA_KV_TYPE" -ctv "$LLAMA_KV_TYPE" \
  -t "$LLAMA_THREADS_HELPER" -tb "$LLAMA_THREADS_HELPER" \
  -c "$LLAMA_CTX_HELPER" -np 1 \
  -b "$LLAMA_BATCH" -ub "$LLAMA_UBATCH" \
  --n-predict 1024 \
  --jinja'

# ── 4) VISION (:8093) — โมเดลอ่านภาพ (multimodal) ─────────────────────────────
export LLAMA_PORT_VISION=8093
export VISION_MODEL_FILE='/path/to/Qwen2.5-VL-7B-Instruct-UD-Q5_K_XL.gguf'
export VISION_MMPROJ_FILE='/path/to/mmproj-F16.gguf'
export VISION_MODEL_SHA256=''
export LLAMA_CMD_VISION='llama-server \
  -m "$VISION_MODEL_FILE" \
  --mmproj "$VISION_MMPROJ_FILE" \
  --host 0.0.0.0 --port 8093 \
  --alias vision \
  -ngl 99 \
  -fa on \
  -ctk "$LLAMA_KV_TYPE" -ctv "$LLAMA_KV_TYPE" \
  -t "$LLAMA_THREADS_HELPER" -tb "$LLAMA_THREADS_HELPER" \
  -c "$LLAMA_CTX_HELPER" -np 1 \
  -b "$LLAMA_BATCH" -ub "$LLAMA_UBATCH" \
  --n-predict 2048'

# ── 5) IMAGE (text-to-image) — สร้างภาพ + เสียบ LoRA ได้ บน :8094 ──────────────
export T2I_PORT=8094
export T2I_ALIAS=image
export T2I_MODEL='/path/to/diffusers-model-or-hf-id'
export T2I_DTYPE=bf16
export T2I_LORA=''
export T2I_LORA_WEIGHT=0.8
export T2I_OUTDIR="$HOME/t2i-out"
