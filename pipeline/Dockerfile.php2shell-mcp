# =============================================================================
# php2shell-mcp — MCP server ครอบ CVE-2026-109618/109619 exploit toolkit
# -----------------------------------------------------------------------------
# ครอบ php2shell-poc (https://github.com/ikow/php2shell-poc, MIT) 5 chain:
#   A: session injection + LFI → RCE (pre-auth, needs LFI endpoint)
#   B: var_destroy UAF → handler overwrite (PHP runs on target, /proc/self/mem)
#   C: handler mismatch → __destruct → RCE (FPM, needs POP gadget)
#   D: OOM amplification → stale EG() (verify only — mod_php, N/A on our FPM lab)
#   E: FPM session OOM → stale BG() (verify only — full exploit not public)
# + scanner (4-tier: version, upload_progress, session write, OOM diff)
# =============================================================================
FROM python:3.12-slim

# php-cli สำหรับ chain_b_uaf_rce.php (runs on target หรือ local verify)
RUN apt-get update && apt-get install -y --no-install-recommends \
        php-cli \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "mcp>=1.8,<2"

# exploit + poc + scanner scripts (build context = project root)
COPY pipeline/php2shell-poc/exploit/ /app/php2shell-poc/exploit/
COPY pipeline/php2shell-poc/poc/     /app/php2shell-poc/poc/
COPY pipeline/php2shell-poc/scanner/ /app/php2shell-poc/scanner/

# MCP server
COPY pipeline/php2shell_mcp_server.py /app/php2shell_mcp_server.py

ENV MCP_HOST=0.0.0.0 \
    MCP_PORT=8008 \
    PHP2SHELL_TARGET=http://host.docker.internal:18056

EXPOSE 8008
CMD ["python", "/app/php2shell_mcp_server.py"]
