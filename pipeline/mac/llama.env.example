# คัดลอกเป็น llama.env แล้วแก้ให้ตรงเครื่อง:  cp llama.env.example llama.env
# start.command จะอ่านไฟล์นี้เพื่อสตาร์ท llama.cpp ให้อัตโนมัติ (ถ้าพอร์ตยังว่าง)
#
# มี 2 โมเดลรันคู่กัน (RAM ~45GB รวม — เครื่องคุณเหลือ ~72GB สบาย):
#   1) ORCHESTRATOR (:8090) = Cyber-Tiel-Coder-35B-A3B  → วางแผน + เรียก tool
#   2) SPECIALIST  (:8091) = BugTraceAI-CORE-Ultra-27B  → เขียน exploit/PoC/payload
#      (Tiel เรียกผ่าน MCP tool `ask_exploit_specialist`)
#
# กติกาสำคัญของ LLAMA_CMD ทั้งคู่:
#   - --port ต้องตรงกับที่ litellm-config.yaml ชี้ (8090 และ 8091)
#   - --alias ต้องตรงกับ `model: openai/<alias>` ใน litellm-config.yaml
#       :8090 → --alias cybermodel
#       :8091 → --alias exploit-specialist
#   - -ngl 99 โหลดทุก layer ลง Metal (GPU) ของ Apple Silicon
#   - --jinja เปิด tool calling — จำเป็นเฉพาะ ORCHESTRATOR (ตัวที่เรียก HexStrike)
#     SPECIALIST ไม่เรียก tool (text-in/out ล้วน) จะใส่หรือไม่ใส่ก็ได้
#   - อย่าใส่ --api-key สำหรับ loopback ภายในเครื่อง (litellm ใช้ "sk-local" เป็น
#     placeholder อยู่แล้ว ถ้าใส่ key จริงต้องให้ตรงกันสองฝั่ง)

# ── 1) ORCHESTRATOR — Cyber-Tiel-Coder-35B-A3B บน :8090 ──────────────────────
export LLAMA_PORT=8090
export LLAMA_CMD='llama-server \
  -m /path/to/Cyber-Tiel-Coder-35B-A3B.gguf \
  --host 0.0.0.0 --port 8090 \
  --alias cybermodel \
  -ngl 99 --jinja \
  -c 16384'

# ── 2) SPECIALIST — BugTraceAI-CORE-Ultra-27B บน :8091 ───────────────────────
# ปล่อยว่าง (คอมเมนต์ไว้) ได้ ถ้ายังไม่อยากรันตัวที่ 2 — pipeline ส่วนอื่นยังทำงานปกติ
# แค่ tool `ask_exploit_specialist` จะคืน error จนกว่าจะสตาร์ทตัวนี้
#   Q6_K ~21GB (คมสุดเท่าที่ RAM ไหว) / Q4_K_S ~15GB (ประหยัดกว่า)
# สลับไป DeepHat-V1-7B ก็แค่เปลี่ยน -m เป็นไฟล์ gguf ของ DeepHat (alias คงเดิม)
export LLAMA_PORT_SPECIALIST=8091
export LLAMA_CMD_SPECIALIST='llama-server \
  -m /path/to/BugTraceAI-CORE-Ultra-27B.Q6_K.gguf \
  --host 0.0.0.0 --port 8091 \
  --alias exploit-specialist \
  -ngl 99 \
  -c 16384'
