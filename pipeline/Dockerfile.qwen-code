# =============================================================================
# Qwen Code Studio — Unified Orchestrator Harness (Docker Isolation)
# -----------------------------------------------------------------------------
# Replaces legacy harnesses with Qwen Code Studio inside Docker.
# Shell commands and code execution run in container sandbox for safety.
# Communicates with LiteLLM (:4000) and internal MCP microservices (:8001-:8009).
# =============================================================================
FROM node:22-bookworm-slim

# System tools, python3, and Pillow for TLP docx report compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    procps \
    ca-certificates \
    python3 \
    python3-pip \
 && pip3 install --no-cache-dir --break-system-packages pillow \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

# Pin the inspected native-agent/tool implementation for reproducible builds.
RUN npm install -g @qwen-code/qwen-code@0.27.2

WORKDIR /workspace

# Entrypoint script
COPY pipeline/qwen-code/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 3080

ENTRYPOINT ["/app/entrypoint.sh"]
