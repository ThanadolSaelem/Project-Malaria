# คัดลอกเป็น pipeline/.env แล้วใส่ค่าจริง (ไฟล์ .env ถูก gitignore แล้ว)
# ---------------------------------------------------------------------------

# ── provider keys (LiteLLM ใช้) ────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-REPLACE_ME          # จาก build.nvidia.com/settings/api-keys
GROQ_API_KEY=gsk_REPLACE_ME              # จาก console.groq.com
CEREBRAS_API_KEY=csk-REPLACE_ME          # จาก cloud.cerebras.ai

# ── HexStrike server ที่ตัวจริงรันเครื่องมือ 150+ ตัว ───────────────────────
# เลือกหนึ่งใน 2 โหมด:
#  (A) รัน server แยกบน Kali/Parrot เอง (ค่าเริ่ม) — ชี้มาที่ host
HEXSTRIKE_SERVER=http://host.docker.internal:8888
#  (B) ให้ compose build+รัน server ให้ด้วย: docker compose --profile full up -d --build
#      แล้วเปลี่ยนบรรทัดบนเป็น service name ในเครือข่าย compose:
# HEXSTRIKE_SERVER=http://hexstrike-server:8888

# ── HarnessRouter console login (เปลี่ยนก่อนเปิดให้เครื่องอื่นเข้าถึง) ──────
HR_AUTH_USER=harnessrouter
HR_AUTH_PASSWORD=change-me-now

# ── connection + policy: ชี้ harness ให้ยิงโมเดลผ่าน LiteLLM ────────────────
# provider "custom" = OpenAI-compatible endpoint ทั่วไป ใช้ได้กับ Claude Code,
# Qwen Code, OpenCode, Cline, DeepSeek Harness, Hermes, Pi, Oh My Pi
# api_key ใส่อะไรก็ได้ (LiteLLM ฝั่งนี้ไม่ได้บังคับ key) แต่ต้องมีค่า
HR_SECRET_GLOBAL_HARNESS_CONN_LITELLM={"name":"litellm","provider":"custom","api_key":"sk-anything","base_url":"http://litellm:4000/v1"}

# เลือก backend ที่จะใช้ connection นี้ (แก้ให้ตรง harness ที่คุณจะรัน)
# provider "custom" รองรับ: Claude Code, Qwen Code, OpenCode, Cline, DeepSeek Harness, Hermes, Pi, Oh My Pi
HR_SECRET_GLOBAL_HARNESS_POLICY_CLAUDE={"chain":["litellm"]}
# HR_SECRET_GLOBAL_HARNESS_POLICY_HERMES={"chain":["litellm"]}

# ── Codex ต้องแยกต่างหาก ──────────────────────────────────────────────────
# Codex ใช้ provider "custom" ไม่ได้ (support matrix รองรับเฉพาะ openai/openrouter/
# azure-foundry/tokenrouter/vercel/llmtr) จึงต้องมี connection แบบ "openai" อีกตัว
# ชี้ไป LiteLLM เดียวกัน แล้วผูก policy ของ codex เข้ากับมัน
# หมายเหตุ: ตอนสั่ง task ต้องเลือกโมเดลเป็น "big-brain" (สิ่งที่ LiteLLM ให้บริการ)
#           ไม่ใช่ gpt-5.5 — ไม่งั้นจะได้ error "no provider ... serves 'gpt-5.5'"
# HR_SECRET_GLOBAL_HARNESS_CONN_LITELLM_OAI={"name":"litellm-oai","provider":"openai","api_key":"sk-anything","base_url":"http://litellm:4000/v1"}
# HR_SECRET_GLOBAL_HARNESS_POLICY_CODEX={"chain":["litellm-oai"]}
