# คัดลอกเป็น llama.env แล้วแก้ให้ตรงเครื่อง:  cp llama.env.example llama.env
# start.command จะอ่านไฟล์นี้เพื่อสตาร์ท llama.cpp ให้อัตโนมัติ (ถ้าพอร์ตยังว่าง)
#
# LLAMA_CMD = คำสั่งเต็มของ llama-server บนเครื่องคุณ
#   - ต้องฟังที่พอร์ตเดียวกับที่ litellm-config.yaml ชี้ไป (ตอนนี้คือ :8090)
#   - --alias cybermodel ให้ตรงกับ model ใน litellm-config.yaml
#   - -ngl 99 เพื่อโหลดทุก layer ลง Metal (GPU) ของ Apple Silicon
#   - --jinja เปิด tool calling (จำเป็นสำหรับ HexStrike MCP)
#   - อย่าใส่ --api-key สำหรับ loopback ภายในเครื่อง (litellm ใช้ api_key: "sk-local"
#     เป็น placeholder อยู่แล้ว ถ้าใส่ key จริงต้องให้ตรงกันสองฝั่ง)

export LLAMA_PORT=8090
export LLAMA_CMD='llama-server \
  -m /path/to/Cyber-Tiel-Coder-35B-A3B.gguf \
  --host 0.0.0.0 --port 8090 \
  --alias cybermodel \
  -ngl 99 --jinja \
  -c 16384'
