{
  "$schema": "https://json.schemastore.org/qwen-settings.json",
  "modelProviders": {
    "openai": [
      {
        "id": "orchestrator",
        "name": "Inkling-2-Mini-abliterated-Mix-12G (:8090)",
        "baseUrl": "http://litellm:4000/v1",
        "envKey": "OPENAI_API_KEY"
      },
      {
        "id": "cyber-model",
        "name": "Cyber-Model (Cyber Security)",
        "baseUrl": "http://litellm:4000/v1",
        "envKey": "OPENAI_API_KEY"
      },
      {
        "id": "summarizer",
        "name": "Summarizer (Intent & Observer)",
        "baseUrl": "http://litellm:4000/v1",
        "envKey": "OPENAI_API_KEY"
      },
      {
        "id": "vision",
        "name": "Vision (Qwen2.5-VL)",
        "baseUrl": "http://litellm:4000/v1",
        "envKey": "OPENAI_API_KEY"
      },
      {
        "id": "nim",
        "name": "NVIDIA NIM (Nemotron VL 120B Cloud)",
        "baseUrl": "http://litellm:4000/v1",
        "envKey": "OPENAI_API_KEY"
      },
      {
        "id": "or-nemo",
        "name": "OpenRouter (GLM-5.3 Cloud)",
        "baseUrl": "http://litellm:4000/v1",
        "envKey": "OPENAI_API_KEY"
      }
    ]
  },
  "model": {
    "name": "orchestrator"
  },
  "context": {
    "fileName": "AGENTS.md"
  },
  "agents": {
    "defaultBackground": false
  },
  "mcpServers": {
    "hexstrike": {
      "httpUrl": "http://hexstrike-mcp:8001/mcp",
      "trust": true
    },
    "rea": {
      "httpUrl": "http://rea-mcp:8007/mcp",
      "trust": true
    },
    "memory": {
      "httpUrl": "http://memory-mcp:8002/mcp",
      "trust": true
    },
    "cve": {
      "httpUrl": "http://cve-mcp:8009/mcp",
      "trust": true
    },
    "search": {
      "httpUrl": "http://search-mcp:8004/mcp",
      "trust": true
    },
    "specialist": {
      "httpUrl": "http://specialist-mcp:8003/mcp",
      "trust": true
    },
    "scopesentry": {
      "httpUrl": "http://scope-sentry:8082/mcp",
      "trust": true,
      "headers": {
        "X-API-Key": "ssk_project_malaria_scopesentry_mcp_key_2026"
      }
    },
    "artex": {
      "httpUrl": "http://artex:8787/mcp",
      "trust": true,
      "headers": {
        "X-API-Key": "ak_project_malaria_artex_mcp_key_2026"
      }
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "artex-shared-context",
            "command": "node /app/hooks/artex-context-hook.mjs prompt",
            "timeout": 8000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "artex-sync-reply",
            "command": "node /app/hooks/artex-context-hook.mjs stop",
            "timeout": 8000
          }
        ]
      }
    ]
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "tools": {
    "approvalMode": "auto"
  },
  "experimental": {
    "agentTeam": false
  },
  "$version": 4
}